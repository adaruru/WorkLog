{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkLog",
  "version": "0.1.0",
  "identifier": "com.adaruru.worklog",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WorkLog",
        "width": 860,
        "height": 540,
        "minWidth": 680,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
